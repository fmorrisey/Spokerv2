# Caddy reverse proxy configuration for Cloudflare Tunnel
# TLS is terminated at Cloudflare, so we serve HTTP only

{
	auto_https off
}

# Default handler - returns 404 for requests without matching hostname
http://:8080 {
	respond "Not Found" 404
}

# Spoker App - Production (HTTP only - TLS handled by Cloudflare)
http://{$APP_NAME:spoker}-app.rainierserver.com:8080 {
	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API requests go to backend (same-origin only via CORS)
	handle /api/* {
		reverse_proxy {$APP_NAME:spoker}-backend:5001
	}

	# All other requests go to frontend
	handle {
		reverse_proxy {$APP_NAME:spoker}-frontend:80
	}
}
