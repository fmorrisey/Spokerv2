# Production Environment Variables for Cloudflare Tunnel Deployment
# Copy this file to .env.prod and fill in your values
# NEVER commit .env.prod to git

# =============================================================================
# DATABASE (MongoDB Atlas)
# =============================================================================
# Get your connection string from MongoDB Atlas dashboard
DB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DB_NAME=ecommerce

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV=production
PORT=5001

# =============================================================================
# CORS
# =============================================================================
# Only allow requests from the app origin (API is same-origin)
ALLOWED_ORIGINS=https://spoker-app.rainierserver.com

# =============================================================================
# API
# =============================================================================
API_VERSION=v1
API_BASE_URL=/api/

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate secrets with: openssl rand -base64 32  (run twice, one for each)
JWT_SECRET=generate-with-openssl-rand-base64-32
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=generate-with-openssl-rand-base64-32
JWT_REFRESH_EXPIRATION=7d

# =============================================================================
# DEMO MODE
# =============================================================================
# Set to true to run the app in demo mode (session-scoped edits, no real auth)
# WARNING: Do not leave this enabled in a real production environment
DEMO_MODE=false
