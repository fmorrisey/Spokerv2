# Backend Environment Variables

# Server Configuration
NODE_ENV=production
PORT=5001

# Database Configuration
DB_URI=mongodb://db:27017/ecommerce
DB_NAME=ecommerce

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3200,https://yourdomain.com

# API Configuration
API_VERSION=v1
API_BASE_URL=/api/

# Security
SESSION_SECRET=your-secure-session-secret-here-change-in-production

# Optional: JWT Configuration (if you add auth later)
# JWT_SECRET=your-jwt-secret-here
# JWT_EXPIRATION=24h

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
