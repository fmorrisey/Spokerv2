# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# =============================================================================
# SERVER
# =============================================================================
NODE_ENV=production
PORT=5001

# =============================================================================
# DATABASE
# =============================================================================
# For local development without auth:
DB_URI=mongodb://db:27017/ecommerce
# For authenticated MongoDB (production):
# DB_URI=mongodb://admin:${MONGO_PASSWORD}@db:27017/ecommerce?authSource=admin
DB_NAME=ecommerce

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins — do not include localhost in production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# API
# =============================================================================
API_VERSION=v1
API_BASE_URL=/api/

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Generate secrets with: openssl rand -base64 32  (run twice, one for each)
# WARNING: Must be set to strong random values — never use placeholders in production
JWT_SECRET=change-me-to-a-secure-random-value
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-to-a-secure-random-value
JWT_REFRESH_EXPIRATION=7d

# =============================================================================
# DEMO MODE
# =============================================================================
# Set to true to run the app in demo mode (session-scoped edits, no real auth)
# WARNING: Do not leave this enabled in a real production environment
DEMO_MODE=true

# =============================================================================
# ROLES / RBAC
# =============================================================================
# Comma-separated list of emails granted the `owner` role on register/login.
# Owners can create/update/delete products; everyone else is a `customer`.
# The allowlist only promotes to owner — it never demotes.
OWNER_EMAILS=

# Demo owner account created by `npm run seed`. Change the password before
# using in any shared environment.
SEED_OWNER_EMAIL=owner@spoker.dev
SEED_OWNER_PASSWORD=ownerpassword
SEED_OWNER_NAME=Demo Owner
