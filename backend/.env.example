# Backend Environment Variables

# Server Configuration
NODE_ENV=production
PORT=5001

# Database Configuration
# For authenticated MongoDB (production), use:
# DB_URI=mongodb://admin:${MONGO_PASSWORD}@db:27017/ecommerce?authSource=admin
# For local development without auth:
DB_URI=mongodb://db:27017/ecommerce
DB_NAME=ecommerce

# MongoDB Authentication (required for production)
# Generate a secure password: openssl rand -base64 24
# MONGO_PASSWORD=your-secure-mongo-password-here

# Enables demo features
DEMO_MODE=true


# CORS Configuration (comma-separated list of allowed origins)
# In production, list only your actual domains - do not include localhost
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# API Configuration
API_VERSION=v1
API_BASE_URL=/api/

# Security (for future use when session management is implemented)
# Generate a secure random secret using one of these commands:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET=your-secure-session-secret-here-change-in-production

# Demo Mode
# Set to true to enable demo mode (read-only session-isolated frontend, auto-seeded products)
# DEMO_MODE=true

# JWT Configuration
# Generate secrets (examples):
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# WARNING: These secrets MUST be set to strong, randomly generated values.
#          Do NOT use placeholder values in production or any shared environment.
# REQUIRED: Uncomment and set secure values before running the application.
# JWT_SECRET=change-me-to-a-secure-random-value
JWT_EXPIRATION=15m
# JWT_REFRESH_SECRET=change-me-to-a-secure-random-value
JWT_REFRESH_EXPIRATION=7d

# Optional: Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
