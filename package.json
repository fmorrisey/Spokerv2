{
    "name": "spoker-v2-root",
    "project": "Spoker v2",
    "version": "0.0.0",
    "author": "Forrest Morrisey",
    "license": "MIT",
    "scripts": {
        "ng": "ng",
        "build:dev": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up --build",
        "docker:dev": "docker compose -f docker-compose.dev.yml up",
        "build:prod": "docker compose -f docker-compose.prod.yml up --build",
        "docker:prod": "docker compose -f docker-compose.prod.yml up",
        "docker:test": "echo \"Error: no test specified\" && exit 1",
        "test": "npm run test:backend && npm run test:frontend",
        "test:backend": "npm run test --prefix=backend",
        "test:frontend": "npm run test --prefix=frontend",
        "swagger:gen": "node tools/scripts/generate-types.js",
        "seed": "node tools/scripts/seed.js",
        "version:check": "./tools/scripts/check-version.sh",
        "deploy": "./tools/scripts/deploy.sh"
    },
    "devDependencies": {
        "openapi-typescript": "*"
    }
}
